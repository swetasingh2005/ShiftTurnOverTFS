<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="PrintPDF.master.cs" Inherits="ShiftTurnover.PrintPDF" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title><%: Page.Title %></title>

    	<meta http-equiv="X-UA-Compatible" content="IE=edge;chrome=1" />

<!--[if lt IE 9]>
	<script src="https://code.jquery.com/jquery-1.10.2.js"></script>
<![endif]-->
<!--[if gte IE 9]><!-->
	<script src="https://code.jquery.com/jquery-2.0.3.js"></script>
<!--<![endif]-->

    <!--  -->
    <link href="~/Content/bootstrap.css" rel="stylesheet" runat="server" />

    <script type="text/javascript" src="Scripts/bootstrap.js"></script>
    <script type="text/javascript" src="Scripts/superfish.js"></script>

    <link href="~/Content/styles.css" rel="stylesheet" runat="server" />
    <link href="~/Content/superfish.css" type="text/css" rel="stylesheet" media="screen" runat="server" />
    <script src="Scripts/Highcharts-4.0.1/js/highcharts.js"></script>

        <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    </head>
<body id="mpage">
    <form id="form1" runat="server" name="form1">
        <asp:Label ID="lblTitle" runat="server" Visible="false"></asp:Label>
       
        <!-- BEGIN MAIN CONTENT -->
        <asp:Table ID="maincontent" runat="server" CellSpacing="0" CellPadding="0" >
            <asp:TableRow VerticalAlign="Top">
                <asp:TableCell ID="widecolumn">
                          <asp:ScriptManager ID="ScriptManger1" runat="Server" /> 

      
    <!-- BEGIN WIDE COLUMN OF MAIN CONTENT -->
                    <div class="font-weight-bold">
                        <asp:ContentPlaceHolder ID="cph_ReportingPeriod" runat="server">
                            <br />

                        </asp:ContentPlaceHolder>
                    </div>

                    <div>
                        <asp:ContentPlaceHolder ID="cph_title" runat="server">
                            <h1><%= lblTitle.Text %></h1>
                        </asp:ContentPlaceHolder>
      
        <asp:Table ID="tableMain" runat="server" CellPadding="10" CellSpacing="0" HorizontalAlign="Center" Width="100%">
            <asp:TableRow>
                <asp:TableCell VerticalAlign="Top">
  
                        <asp:ContentPlaceHolder ID="cph_main" runat="server">
                   
                        </asp:ContentPlaceHolder>
                </asp:TableCell>
            </asp:TableRow>
        </asp:Table>           
    </div>
                    <!-- END WIDE COLUMN OF MAIN CONTENT -->
                    </asp:TableCell>
                
                <asp:TableCell ID="narrowcolumn" Visible="false">
                <!-- BEGIN SIDE COLUMN OF MAIN CONTENT -->
                         
                <!-- END SIDE COLUMN OF MAIN CONTENT -->
                </asp:TableCell>
                </asp:TableRow>
    </asp:Table>
        <!-- END MAIN CONTENT -->
    <div>
                <asp:ContentPlaceHolder ID="cph_footer" runat="server">
                    <div id="footer">
                    
                    </div>
                </asp:ContentPlaceHolder>
            
        
        
    </div>
    </form>
</body>
</html>
